# Movie Land Ultra — MyXvest Apache Security & WebApp Routing
DirectoryIndex index.php index.html
Options -Indexes

# Protect SQLite database, Python source code, configs, secrets, logs, shell scripts, and backups
<FilesMatch "\.(db|db-wal|db-shm|sqlite|sqlite3|py|pyc|pyo|sh|bat|log|pid|env|service|yml|yaml|md|txt|sql|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(\.env|\.git|\.htaccess|Dockerfile|LICENSE|ecosystem\.config\.js|movieland_backup\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Block hidden directories (.git, .venv, etc.) and backups/
    RewriteRule ^(\.git|backups|__pycache__|micromamba)(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
